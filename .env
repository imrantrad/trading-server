# TRD v12.3 — Environment Configuration
# Copy to .env and fill values

# ── SERVER ──────────────────────────────────
APP_NAME=TRD v12.3 Institutional
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# ── SECURITY ────────────────────────────────
SECRET_KEY=trd-change-this-secret-key-in-production
ADMIN_KEY=TRD_ADMIN_2026
JWT_EXPIRE_MINUTES=1440

# ── DATABASE ────────────────────────────────
DB_TYPE=sqlite
SQLITE_PATH=./database/users.db
# PostgreSQL (future):
# DB_URL=postgresql://user:pass@localhost:5432/trd

# ── CACHE ───────────────────────────────────
CACHE_TYPE=memory
# Redis (production):
# REDIS_URL=redis://localhost:6379/0

# ── EMAIL ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@trd.ai

# ── BROKERS ─────────────────────────────────
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_API_KEY=
ZERODHA_API_KEY=
ZERODHA_SECRET=

# ── GOOGLE OAUTH ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── PAYMENT ─────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

# ── MONITORING ──────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
